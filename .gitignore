# ========================================
# ListenVision 项目 - 统一 .gitignore
# ========================================

# ---------- 依赖 ----------

package-lock.json
yarn.lock
pnpm-lock.yaml

# Flutter/Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
.publog
pubspec.lock
!frontend_flutter/pubspec.lock

# ---------- 环境变量 / 敏感信息 ----------

.env
.env.*
!.env.example
lib/config/local_config.dart

# ---------- 日志 ----------

logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 操作系统 ----------

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ---------- IDE ----------

.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
*.code-workspace
*.swp
*.swo
*~

# ---------- 构建输出 ----------

build/
.android/
.ios/
.web/
linux/
windows/
macos/
dist/
out/
*.tgz
frontend_flutter/release/
frontend_flutter/build_log.txt

# ---------- 测试覆盖率 ----------

coverage/
.nyc_output/
test/reports/
.lcov/

# ---------- 数据库 ----------

data/
!frontend_flutter/lib/data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ---------- 临时文件 ----------

*.tmp
*.temp
*.tar.gz
*.zip
*.rar
cache/
.cache/

# ---------- 其他 ----------

references/
.sisyphus/
nul
node_modules/
bs3.tar.gz
better-sqlite3.tar.gz
.claude/

# 备份文件
*.bak
*.backup
