    "express-validator": "^7.3.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^7.0.3",
    "qrcode": "^1.5.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
